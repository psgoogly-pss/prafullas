---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort((a, b) =>
    a.localeCompare(b),
);
const locations = [...new Set(jobs.map((job) => job.location))].sort((a, b) =>
    a.localeCompare(b),
);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <div
          class="mb-6 grid grid-cols-1 gap-4 rounded-xl border border-slate-700 bg-slate-800/50 p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
          data-testid="role-filters"
        >
          <div>
            <label for="department-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Department
            </label>
            <select
              id="department-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              data-testid="department-filter"
              aria-controls="roles-grid"
            >
              <option value="">All departments</option>
              {departments.map((department) => <option value={department}>{department}</option>)}
            </select>
          </div>
          <div>
            <label for="location-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Location
            </label>
            <select
              id="location-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              data-testid="location-filter"
              aria-controls="roles-grid"
            >
              <option value="">All locations</option>
              {locations.map((location) => <option value={location}>{location}</option>)}
            </select>
          </div>
          <button
            type="button"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 hover:border-blue-500 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            data-testid="filter-reset"
          >
            Reset filters
          </button>
        </div>

        <div
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          id="roles-grid"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <div data-testid="filter-empty-state" aria-live="polite" hidden>
          <EmptyState text="No roles match your filters. Try changing or resetting them." />
        </div>
      </>
    )}
  </div>
</Layout>

<script
  type="application/json"
  data-testid="roles-data"
  is:inline
  set:html={JSON.stringify(jobs).replace(/</g, '\\u003c')}
/>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const rolesData = document.querySelector<HTMLScriptElement>('[data-testid="roles-data"]');
  const departmentFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="department-filter"]',
  );
  const locationFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="location-filter"]',
  );
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="filter-reset"]');
  const roleCards = document.querySelectorAll<HTMLElement>('[data-testid="role-card"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  if (
    rolesData &&
    departmentFilter &&
    locationFilter &&
    resetButton &&
    emptyState
  ) {
    const jobs: Job[] = JSON.parse(rolesData.textContent ?? '');

    const updateVisibleRoles = (): void => {
      const visibleSlugs = new Set(
        filterJobs(jobs, {
          department: departmentFilter.value,
          location: locationFilter.value,
        }).map((job) => job.slug),
      );

      roleCards.forEach((card) => {
        card.hidden = !visibleSlugs.has(card.dataset.jobId ?? '');
      });
      emptyState.hidden = visibleSlugs.size > 0;
    };

    departmentFilter.addEventListener('change', updateVisibleRoles);
    locationFilter.addEventListener('change', updateVisibleRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateVisibleRoles();
    });
  }
</script>
